# =============================================================================
# Wind Turbine Streaming Platform - Environment Variables
# =============================================================================
# Copy this file to .env and update values for your environment.

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SCHEMA_REGISTRY_URL=http://schema-registry:8081

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# TimescaleDB
TIMESCALEDB_HOST=timescaledb
TIMESCALEDB_PORT=5432
TIMESCALEDB_DB=windturbine
TIMESCALEDB_USER=windturbine
TIMESCALEDB_PASSWORD=changeme_in_production

# Spark
SPARK_MASTER=local[*]

# Airflow
AIRFLOW__CORE__FERNET_KEY=your-fernet-key-here
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@airflow-postgres:5432/airflow

# Monitoring
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_RETENTION_DAYS=15
